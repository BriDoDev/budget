# Supabase project (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: bypasses row level security. Only used by scripts, never by the app.
SUPABASE_SECRET_KEY=

# Public URL of the app, used for magic-link redirects when the Origin header is missing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma separated household members allowed to sign in. The first one owns the household.
ALLOWED_EMAILS=

# YNAB import (YNAB → Account Settings → Developer Settings → Personal Access Token)
YNAB_ACCESS_TOKEN=
YNAB_PLAN_ID=last-used
HOUSEHOLD_NAME=Hogar
